{
  "name": "onememory",
  "private": true,
  "description": "One memory across every agent — open-source, self-hostable, local-first persistent memory engine for AI coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "benchmarks/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:node": "vitest run",
    "build": "bun run scripts/build.ts",
    "release:order": "bun run scripts/release.ts order",
    "release:stage": "bun run scripts/release.ts stage",
    "release:pack": "bun run scripts/release.ts pack",
    "release:publish": "bun run scripts/release.ts publish",
    "smoke:packed": "bun run scripts/smoke-packed.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
