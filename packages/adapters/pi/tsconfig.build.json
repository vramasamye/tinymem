{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.scenarios.ts",
    "src/**/scenarios.ts",
    "src/**/testing.ts",
    "src/**/testing/**",
    "src/**/test-support.ts",
    "src/**/test-support/**",
    "src/**/test-world.ts",
    "src/**/fixtures.ts"
  ]
}
