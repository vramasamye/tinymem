{
  "name": "@onememory/codememory",
  "version": "0.1.0",
  "description": "Local code fingerprints: Git index/worktree snapshots, rename-aware changes, filesystem hash fallback, and tree-sitter symbol extraction",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun run src/fingerprints.bench.ts"
  },
  "dependencies": {
    "@onememory/core": "workspace:*",
    "@onememory/security": "workspace:*",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@onememory/extraction": "workspace:*",
    "@onememory/storage": "workspace:*",
    "@types/bun": "^1.4.2"
  }
}
