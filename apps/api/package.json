{
  "name": "@onememory-ai/api",
  "version": "0.1.0",
  "description": "onememory REST API (/v1) + the shared runtime composition root (storage, security, retrieval, model router, job handlers)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/bin.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "2.3.0",
    "@onememory-ai/adapter-claude": "workspace:*",
    "@onememory-ai/adapter-codex": "workspace:*",
    "@onememory-ai/adapter-cursor": "workspace:*",
    "@onememory-ai/adapter-opencode": "workspace:*",
    "@onememory-ai/adapter-pi": "workspace:*",
    "@onememory-ai/codememory": "workspace:*",
    "@onememory-ai/config": "workspace:*",
    "@onememory-ai/consolidation": "workspace:*",
    "@onememory-ai/core": "workspace:*",
    "@onememory-ai/embeddings": "workspace:*",
    "@onememory-ai/extraction": "workspace:*",
    "@onememory-ai/llm": "workspace:*",
    "@onememory-ai/mcp": "workspace:*",
    "@onememory-ai/retrieval": "workspace:*",
    "@onememory-ai/security": "workspace:*",
    "@onememory-ai/storage": "workspace:*",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
